// and other `\x` → the GNU escape value.
function sedReplJs(repl) {
  let out = '';
  for (let i = 0; i < repl.length; i++) {
    const c = repl[i];
    if (c === '\\') {
      const d = repl[i + 1] ?? '';
      i++;
      if (d === '&') out += '&';
      else if (d === '\\') out += '\\\\';
      else if (d === 't') out += '\t';
      else if (d === 'n') out += '\n';
      else if (d >= '1' && d <= '9') out += '$' + d;
