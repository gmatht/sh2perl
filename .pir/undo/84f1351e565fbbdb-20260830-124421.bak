        let closed = false;
        while (i < n) {
          const c = script[i];
          if (c === '\\') {
            const d = script[i + 1] ?? '';
            if (quoted) { re += d; i += 2; continue; }   // 'RE': backslashes literal
            if (d === delim) { re += '\\' + delim; i += 2; continue; }
