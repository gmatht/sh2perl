# shir_nodes/field_read.node — FieldRead: named field read on a composite
# VALUE (struct literal field access: `p.x` where p = Point { x: 1, .. }).
#
# GENERIC. object is any expression evaluating to a record/object value;
# name is the plain field ident. Tuple-index reads (`p.0`) are NOT this
# node — they keep refusing until a tuple contract lands. Named-variable
# struct storage keeps existing A1 shapes; THIS node covers the
# expression-position form frontends previously had no shape for.
# Numeric NAMES ("0", "1" on tuples) render COMPUTED access
# (JS obj[0], Perl $obj->[0]) — the name is then an INDEX.
# Backends: JS obj.name / obj[0] (native MemberExpression),
# Perl $obj->{name} / $obj->[0].

node FieldRead
tag "FieldRead"
kind expr
# storage_class str_bounded
field object: expr
field name: string
