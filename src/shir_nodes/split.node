# shir_nodes/split.node — primitive: split a string into an array by a delimiter.
# Every language has split(). Composition base for wc -l / wc -w / cut / head / tail.

node Split
tag "Split"
kind expr
field text: expr
field delim: string
field is_regex: bool
# in_place: the source buffer may be DESTROYED (delimiters stamped with
# NUL) — set by liveness analysis when the source var is dead after the
# split. C renders an in-place tokenizer on the var's own storage; GC'd
# string languages ignore it (immutable strings — flag meaningless).
field in_place: optional_bool
