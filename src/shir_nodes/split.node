# shir_nodes/split.node — primitive: split a string into an array by a delimiter.
# Every language has split(). Composition base for wc -l / wc -w / cut / head / tail.

node Split
tag "Split"
kind expr
# storage_class str_bounded
field text: expr
field delim: string
field is_regex: bool
# in_place: the source buffer may be DESTROYED (delimiters stamped with
# NUL) — set by liveness analysis when the source var is dead after the
# split. C renders an in-place tokenizer on the var's own storage; GC'd
# string languages ignore it (immutable strings — flag meaningless).
field in_place: optional_bool
spec: TextOps#split_ws_len, TextOps#split_ws_fields_clean
# The field LIST is the meaning; what is machine-checked is its count
# (split_ws_len: dropping the empty fields is what makes the count equal the
# ws -w count) and its shape (split_ws_fields_clean: no empty field, no
# whitespace inside one). Per-field byte identity is not yet an obligation —
# see sh2perl/docs/fm/README.md, open targets.
